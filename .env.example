# ============================================================
# Cartrends AutoFlow — configuration
#
#   copy .env.example .env      phir neeche wali values bharein
#
# <ANGLE BRACKETS> = abhi pata nahi, aapko bharna hai.
# Baaki sab values verified hain (2 Sep 2026 tak test ki hui).
#
# ⚠️ Ye file GitHub par jaati hai (repo PUBLIC hai) — isme kabhi
#    asli password/token mat likhna. Woh sirf .env mein.
# ============================================================


# ============================================================
# 1. SCOPE — abhi sirf sales bot
# ============================================================
# purchase / warehouse / finance / helpdesk PARKED hain. Unka code
# maujood hai par boot nahi hote. Baad ke phase mein true karna.
ENABLE_EXTRA_BOTS=false


# ============================================================
# 2. WHATSAPP — official Cloud API  ✅ LIVE, tested
# ============================================================
CUSTOMER_TRANSPORT=cloud
CUSTOMER_BOT_NUMBER=919289015775

# Meta app "cartrendsWorkflow bot" se
WA_PHONE_NUMBER_ID=1328878983638516
WA_WABA_ID=1332473012292578

# ⚠️ SECRET — System User permanent token (EAATZA... se shuru hota hai)
# Business Settings -> System Users -> Generate token (no expiry)
WA_CLOUD_TOKEN=<EAATZA...  apna permanent token>

# Meta webhook handshake ka shared string — aap khud choose karte ho.
# Yahi value Meta ke dashboard mein aur Render pe VERIFY_TOKEN mein bhi.
WA_VERIFY_TOKEN=cartrends-autoflow-verify-2026


# ============================================================
# 3. WEBHOOK RELAY (Render)  ✅ LIVE
# ============================================================
# Meta -> Render relay -> aapka PC (har 3 sec pull karta hai).
# Meta ka Callback URL: https://autoflow-v3bj.onrender.com/webhook/wa
WEBHOOK_RELAY_URL=https://autoflow-main.onrender.com

# ⚠️ SECRET — Render pe RELAY_SECRET mein jo daala hai, bilkul wahi
WEBHOOK_RELAY_SECRET=<Render wala RELAY_SECRET>

WEBHOOK_RELAY_POLL_MS=3000


# ============================================================
# 4. KAUN BOT SE BAAT KAR SAKTA HAI  (safety whitelist)
# ============================================================
# Sirf ye numbers DM par jawab paate hain. Khali = koi nahi.
# "all" = sab (SIRF testing ke liye, production mein kabhi nahi).
CUSTOMER_DMS=


# Ye numbers bot ko command bhej sakte hain:
#   REPORT · LOSS [days] · ORDERS · KNOWN · HELP
#   LEARN <phrase> = <part no>
#   GROUP <name> | <phones> · GROUPS
#   CUSTOMER ADD name, phone · OFFER <text> · CN <phone> <amt> <reason>
ADMIN_NUMBERS=

# Roz itne baje admins ko ops report + sale-loss report jaata hai
DAILY_REPORT_TIME=20:00


# ============================================================
# 5. HUMAN ESCALATION — "bot confuse ho toh kisse poochhe"
# ============================================================
# Part samajh na aaye -> is number ko DM -> jawab customer tak jaata hai
# AUR HAMESHA KE LIYE SEEKH LIYA JAATA HAI (dobara nahi poochhega).
#
# ⚠️ Ye number CUSTOMER_BOT_NUMBER se ALAG hona chahiye.
#    Same hua toh bot khud ko DM karega aur kuch nahi hoga.
ESCALATION_NUMBER=919217030421
ESCALATION_TIMEOUT_MIN=5


# ============================================================
# 6. DEALER PORTAL — stock aur order ka ekmaatr source
# ============================================================
# Vendor stock yahan ProcureHub se aata hai, is project se nahi.
# Base URL khali chhodne par MOCK portal chalta hai (offline testing).
DEALER_PORTAL_BASE_URL=https://vagmine.vagminetech.com/api/v1

# ---- Paths: teeno LIVE API se verify kiye hue hain ----
DEALER_PORTAL_LOGIN_PATH=/auth/login
DEALER_PORTAL_ANALYZE_PATH=/PUSH_ORDER/analyze
DEALER_PORTAL_CONFIRM_PATH=/purchase-orders/confirm
DEALER_PORTAL_TIMEOUT_MS=20000

# ---- Account ----
# ⚠️ Account ke paas dealer link + stock/order permission HONA CHAHIYE.
#    `adi` (admin) se kaam NAHI karta — uska dealer_id null hai.
#
# TESTING mein `gunjan_sales` se chala hai (user_id 1434, dealer_id 8510).
# PRODUCTION ke liye Aneeq sir se service account maangna hai
# (is_service_account=TRUE, dealer_id Cartrends branch par).
DEALER_PORTAL_USERNAME=<gunjan_sales  ya bot ka service account>
DEALER_PORTAL_PASSWORD=<uska password>

# `confirm` API ko user_id chahiye. gunjan_sales ka 1434 hai.
# Naya account mile toh uska user_id yahan daalna.
DEALER_PORTAL_USER_ID=<1434 gunjan ke liye, ya naye account ka>

# Kis Cartrends branch se allocate ho. Khali chhoda toh portal khud
# account ke home branch se decide karta hai (ACCOUNT_HOME_BRANCH).
#   103  = Bijwasan Hub (Ho)
#   23   = BIJWASAN WAREHOUSE
#   1076 = CARTREND AUTO PARTS PRIVATE LIMITED
DEALER_PORTAL_BRANCH_ID=<103  — Aneeq sir se confirm karke>

# Permanent/refresh token mile toh yahan daaliye — phir username/password
# ki zarurat nahi rahegi.
DEALER_PORTAL_TOKEN=

# HAR AGENT KA APNA PORTAL LOGIN (founder, 30 Sep: "when agent ronak punch
# order then access his account and punch order only for order request come
# from his number"). Jis number se order aaya, agar wo number yahan hai toh
# order USI agent ke portal account se punch hota hai — portal pe uska naam,
# uska user. Stock aur rate abhi bhi bot ke login se padhe jate hain; sirf
# punch badalta hai. Jo number yahan nahi hai, wo pehle jaisa hi chalta hai.
#
#   number|username|password            <- user id portal se khud milta hai
#   number|username|password|user_id    <- jis account ka mobile portal pe nahi hai
#
# Ek line mein comma se ya nayi line se alag karke, kitne bhi agent:
DEALER_PORTAL_STAFF_LOGINS=<919217030415|ronak_sales|<uska password>|1227>


# Discount rules: bot unhe seedha Dealer Portal pe PENDING daalta hai; Super
# Admin portal pe khud approve karta hai, aur approve hote hi order pe discount
# lagta hai. Sales Head ko WhatsApp pe kuch nahi jata.


# ============================================================
# 7. QUOTE FRESHNESS — purana rate pe order na lag jaye
# ============================================================
# Beech mein koi aur customer wahi stock le sakta hai. Isliye YES par
# hamesha dobara check hota hai:
#   TTL ke baad stock badla ho -> naye numbers dikha kar dobara poochta hai
#   MAX_AGE ke baad draft khatam -> customer se dobara items maangta hai
QUOTE_TTL_MINUTES=60
QUOTE_MAX_AGE_HOURS=24


# ============================================================
# 8. WHATSAPP GROUPS  ⏸️ abhi BLOCKED
# ============================================================
# Code poora likha aur tested hai, par Meta ne number ko Groups API ke
# liye eligible nahi kiya (oba_status = NOT_STARTED).
# Eligible hote hi ye settings apne aap kaam karne lagengi.
#
# Har naye group mein ye numbers automatically add honge
# (customer ka number iske upar):
GROUP_DEFAULT_MEMBERS=919217396458,917004130460,917701919954
GROUP_SUBJECT_PREFIX=Cartrends


# ============================================================
# 9. GENERAL
# ============================================================
TZ=Asia/Kolkata
CONSOLE_PORT=3010
INTERNAL_WAREHOUSE_NAME=Bijwasan

# Staff customer ko kaise dhoondhein: any = mobile, GST ya naam se;
# mobile = sirf 10 digit mobile number se
CUSTOMER_SEARCH_BY=any

# AI: sab kuch Gemini se hota hai (photos, Hinglish/free-form messages,
# naming, knowledge base) — neeche wali GEMINI_API_KEY. Uske bina bhi
# deterministic parser chalta hai.


# ============================================================
# 10. RENDER par deploy karte waqt (abhi zarurat nahi)
# ============================================================
# Ye do sirf tab chahiye jab poora bot Render pe chale.
# Abhi Render pe sirf relay chal raha hai, bot aapke PC par hai.
# PORT      -> Render khud deta hai, aap mat likhiye
# DATA_DIR  -> /var/data  (persistent disk ke liye)


# ============================================================
# 11. PARKED BOTS — sirf ENABLE_EXTRA_BOTS=true hone par
# ============================================================
# In sab ki abhi koi zarurat nahi. Khali chhod dijiye.
PURCHASE_BOT_NUMBER=
WAREHOUSE_BOT_NUMBER=
FINANCE_BOT_NUMBER=
HELPDESK_BOT_NUMBER=
WAREHOUSE_TEAM_NUMBERS=

STOCK_BROADCAST_TIMES=09:30,16:00
IVR_FOLLOWUP_TIMES=11:30,17:30
INVOICE_CHASE_CRON=0 * * * *

IVR_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Voice notes -> text (Google), so the helper can READ them ---------------
# Transcription is Gemini too. Leave blank
# and voice notes go to a person untranscribed, exactly as before.
# USE A BILLED KEY: on the free tier Google says content is "used to improve
# our products", and these are real customers' voices. Cost is negligible —
# audio bills at 32 tokens/second, so a 15-second note is ~480 tokens.
GEMINI_API_KEY=
# gemini-2.5-flash is the safe default; gemini-3.5-transcribe is cheaper for
# transcription only.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

# Voice notes go to their own person — somebody has to put headphones on,
# and that is a different job from answering a part number. Everything else
# still goes to ESCALATION_NUMBER. Blank = same number as everything else.
VOICE_ESCALATION_NUMBER=917004130460

# --- Odoo: invoices, ledger, credit notes, and the PDF of a sales order ------
# Nothing reads these yet. Use a DEDICATED Odoo user with read rights only on
# sales orders, invoices and the partner ledger. An API key carries the full
# permissions of the user who made it: a key made from an admin account IS
# admin access, and a persistent key keeps working until someone deletes it.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=


# ============================================================
# SELF-LEARNING KNOWLEDGE BASE  (Postgres + pgvector)
# ============================================================
# Kya karta hai: jo sawal Prateek sir ek baar answer kar dete hain, wo agli
# baar bot khud answer karta hai. Sirf BUSINESS sawalon ke liye — return
# policy, warranty, GST, payment terms. Part number dhoondhne ka kaam purane
# exact matching se hi hota hai (wahan "16 inch" aur "18 inch" ka fark
# similarity se nahi nikalta).
#
# DATABASE_URL khaali = feature BAND. Bot bilkul pehle jaisa chalega:
# sawal seedha Prateek sir ke paas jayega. Kuch chupke se kharab nahi hoga.
#
# Chalu karne ke liye:
#   1. docker compose up -d autoflow-db      (pgvector wali image)
#   2. DATABASE_URL neeche bharein
#   3. npm run migrate
#   4. npm start   — boot par "knowledge base: ready" dikhega
# docker-compose autoflow-db isi password se chalta hai.
POSTGRES_PASSWORD=
DATABASE_URL=
# Managed Postgres (Render, Supabase, RDS) par aksar zaroori hota hai.
DATABASE_SSL=false
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=4000

# ⚠️ text-embedding-004 is key par 404 deta hai (retire ho gaya). Is account
# par gemini-embedding-001 aur gemini-embedding-2 chalte hain.
#
# Embeddings Gemini se aate hain — upar wali GEMINI_API_KEY hi use hoti hai.
# Ek hi provider, ek hi key.
#
# ⚠️ EMBEDDING_DIM aur migrations/001 ka vector(768) EK JAISA hona chahiye.
#    Ek badla aur dusra nahi, to har search fail hogi.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_MS=10000

# Kitna milta-julta sawal "wahi sawal" mana jaye.
#
# 0.85 spec se aaya tha aur GALAT tha: asli model par sahi sawal 0.75-0.80
# par aate hain, to kabhi kuch match hi nahi hota tha. Galat sawal 0.46-0.53
# par hain - gap bada hai, bas threshold beech mein hona chahiye.
# /api/kb/search se apne asli sawalon par naap kar tune karein.
KNOWLEDGE_SIMILARITY_THRESHOLD=0.65
KNOWLEDGE_TOP_K=5
# Model khud kitna sure ho tab jawab jaye.
KNOWLEDGE_MIN_CONFIDENCE=0.75
# Itne milte-julte do sawal = ek hi sawal (duplicate nahi banega).
KNOWLEDGE_DUPLICATE_THRESHOLD=0.90

# /api/kb/* aur /api/escalations/* ke liye bearer token. KHAALI = ye endpoints
# BAND rehte hain (khule nahi). Koi lamba random string daalein.
KNOWLEDGE_API_TOKEN=


# ============================================================
# WHATSAPP CHAT HISTORY IMPORT
# ============================================================
# Purane exported chats se bot seekhta hai: dealer kis naam se part maangta
# hai ("barek oil cap", "wiper bottel") aur uska asli part number kya hai.
#
# ⚠️ STOCK, RATE, MRP, DISCOUNT kabhi history se NAHI aate. Wo hamesha
#    dealer portal se aate hain. History sirf ye batati hai ki SAWAL kya tha
#    aur part KAUNSA tha.
#
# Import:
#   npm run import:whatsapp-history -- ./chats/*.zip
#   npm run import:whatsapp-history -- --apply     (approved mappings live karo)
#
# Same ZIP dobara import karna safe hai - kuch duplicate nahi hoga.

# Employee kaun hai, ye display name se pata chalta hai: Cartrends ke logon ke
# naam mein company likhi hoti hai ("Rahul - Warehouse - Cartrend"). Agli baar
# kisi aur phone se export kiya to ye badal sakta hai.
EMPLOYEE_NAME_CONTAINS=cartrend
# Extra naam (comma se alag), agar upar wale marker se na pehchane jayen.
EMPLOYEE_NAMES=
# Numbers, agar export mein phone dikhein.
EMPLOYEE_PHONE_NUMBERS=

# --- Payment before a new order (core/payments) ------------------------------
# A customer who owes Rs 1 or more is asked to settle it first. The accountant
# confirms payments: "OK PAY-XXXX <amount>" / "NO PAY-XXXX".
ACCOUNTANT_NUMBERS=919971194578:Anurag
# The QR sent with the amount: a fixed image in SHARED_DIR (the bank's merchant
# QR), or build one per amount from a UPI id.
PAYMENT_QR_IMAGE=payment-qr.jpg
PAYMENT_UPI_ID=
PAYMENT_UPI_NAME=
PAYMENT_SETTLED_BELOW=1
